# Copy this file to .env. Never commit the resulting .env file.
# Leave real service values empty until you have created and secured the keys.

# EARLY: Gemini function-calling agent.
GEMINI_API_KEY=
# Model used when USE_MOCK_AI=false.
GEMINI_MODEL=gemini-2.0-flash
# EARLY: Google Directions and Distance Matrix web-service requests.
GOOGLE_MAPS_API_KEY=

# MID: Razorpay test-mode checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# MID: Firebase web/app configuration and server credentials.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Optional file path to a Firebase Admin service-account JSON credential for backend token verification and FCM.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# LATE: external travel enrichment services.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
OPENWEATHER_API_KEY=

# Safe local-development defaults: no billable external APIs are called.
USE_MOCK_FLIGHTS=true
USE_MOCK_WEATHER=true
USE_MOCK_PAYMENTS=true
USE_MOCK_MAPS=true
USE_MOCK_AI=true
USE_MOCK_AUTH=true
USE_MOCK_PUSH=true
# Local development token used only when USE_MOCK_AUTH=true.
MOCK_AUTH_TOKEN=smarttrip_demo_token

# Local Docker services. For the API container, Docker Compose overrides hosts.
DATABASE_URL=postgresql+asyncpg://smarttrip:smarttrip@localhost:5432/smarttrip
REDIS_URL=redis://localhost:6379/0
